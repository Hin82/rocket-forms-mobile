{
  "expo": {
    "name": "Rocket Forms Pro",
    "slug": "rocket-forms-pro",
    "version": "2.1.2",
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    "scheme": "rocketforms",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#1a1a2e"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.omniwise.rocketformspro",
      "associatedDomains": [
        "applinks:rocketformspro.com"
      ],
      "infoPlist": {
        "NSCameraUsageDescription": "Used to capture photos and videos for form fields",
        "NSPhotoLibraryUsageDescription": "Used to select images and videos for form fields",
        "NSMicrophoneUsageDescription": "Used to record audio for form fields",
        "NSFaceIDUsageDescription": "Used for quick sign-in"
      }
    },
    "android": {
      "package": "com.omniwise.rocketformspro",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "rocketformspro.com",
              "pathPrefix": "/form/"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "adaptiveIcon": {
        "backgroundColor": "#1a1a2e",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.VIBRATE",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ],
      "blockedPermissions": [
        "android.permission.ACTIVITY_RECOGNITION"
      ],
      "versionCode": 7
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#e8622c"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Used to select images for form fields",
          "cameraPermission": "Used to take photos for logos and form fields"
        }
      ],
      "expo-document-picker",
      [
        "expo-camera",
        {
          "cameraPermission": "Used to record video for form fields",
          "microphonePermission": "Used to record audio for form fields",
          "recordAudioAndroid": true
        }
      ],
      "expo-local-authentication",
      "@react-native-community/datetimepicker",
      "expo-video",
      [
        "expo-audio",
        {
          "microphonePermission": "Used to record audio for form fields"
        }
      ],
      [
        "@sentry/react-native/expo",
        {
          "url": "https://sentry.io/",
          "project": "rocket-forms-app",
          "organization": "omniwise-ab"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "6e42077a-f354-4686-87fd-6824e3d13e90"
      },
      "router": {},
      "privacy": "https://rocketformspro.com/privacy-policy",
      "terms": "https://rocketformspro.com/terms-of-service"
    },
    "owner": "omniwiseab",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/6e42077a-f354-4686-87fd-6824e3d13e90"
    }
  }
}
